    <polyline points="15,5 19,17 24,44 29,17 33,5" stroke="#ffffff" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.6" />
    <line x1="6" y1="17" x2="42" y2="17" stroke="#ffffff" stroke-width="1.3" stroke-opacity="0.5" />
