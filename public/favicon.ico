  <rect width="64" height="64" rx="16" fill="url(#bgGrad)" stroke="#3b82f6" stroke-width="2" stroke-opacity="0.6" />

  <g transform="translate(8, 8)">
    <polygon points="15,5 33,5 29,17 19,17" fill="url(#favFacetTop)" />
